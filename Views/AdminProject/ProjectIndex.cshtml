@model List<KisiselSayfam.Models.Project>

    @{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    <div class="page-header mb-30">
        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div class="title">
                    <h4>Proje Yönetimi</h4>
                </div>
            </div>
            <div class="col-md-6 col-sm-12 text-right">
                <a asp-controller="AdminProject"
                   asp-action="AddAdminProject"
                   class="btn btn-primary">
                    Yeni Ekle
                </a>
            </div>
        </div>
    </div>

    <div class="card-box mb-30">
        <div class="pd-20">
            <h5 class="text-blue h5">Proje Listesi</h5>
        </div>

        <div class="pb-20">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-controller="AdminProject"
                               asp-action="GuncelleAdminProject"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Güncelle
                            </a>

                            <form asp-controller="AdminProject"
                                  asp-action="SilAdminProject"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Silmek istiyor musunuz?');">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
