@model List<KisiselSayfam.Models.Contact>

@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section id="contact" class="contact section">

    
    <div class="container section-title" data-aos="fade-up">
        <h2>İletişim</h2>
        <p>En kısa sürede tarafınıza dönüş sağlanacaktır.</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">

          
            <div class="col-lg-5">
                <div class="info-wrap">

                    <div class="info-item d-flex">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <h3>Adres</h3>
                            <p>Van, Türkiye</p>
                        </div>
                    </div>

                    <div class="info-item d-flex">
                        <i class="bi bi-telephone"></i>
                        <div>
                            <h3>Bizi Arayın</h3>
                            <p>+90 531 430 1852</p>
                        </div>
                    </div>

                    <div class="info-item d-flex">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <h3>Bize mail gönderin</h3>
                            <p>csr.ozlem65@gmail.com</p>
                        </div>
                    </div>

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d17815.123456789!2d43.365!3d38.4946!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x401a9b3f9b6abcdef%3A0x123456789abcdef!2sVan,+Turkey!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
                            style="border:0; width:100%; height:270px;"
                            allowfullscreen
                            loading="lazy">
                    </iframe>

                </div>
            </div>

            
            <div class="col-lg-7">
                <form asp-action="Contact" method="post" data-aos="fade-up">

                    @Html.AntiForgeryToken()

                    <div class="row gy-4">

                        <div class="col-md-6">
                            <label class="pb-2">Adınız</label>
                            <input type="text" name="Name" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="pb-2">Soyadınız</label>
                            <input type="text" name="Surname" class="form-control" required />
                        </div>

                        <div class="col-md-12">
                            <label class="pb-2">Mail adresiniz</label>
                            <input type="email" name="Email" class="form-control" required />
                        </div>

                        <div class="col-md-12">
                            <label class="pb-2">Mesaj</label>
                            <textarea name="Message" id="editor1" rows="6" class="form-control" required></textarea>
                        </div>
                        <script>
                            // Sayfa yüklendiğinde çalışır
                            document.addEventListener("DOMContentLoaded", function () {
                                // 'editor1' id'li textarea'yı CKEditor'e dönüştürür
                                CKEDITOR.replace('editor1');
                            });
                        </script>

                        <div class="col-md-12 text-center">
                            <button type="submit">Mesaj Gönder</button>
                        </div>

                    </div>
                </form>
            </div>

        </div>
    </div>
</section>


<section class="container mt-5">
    <h3 class="text-center mb-4">Gönderilen Mesajlar</h3>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@item.Name @item.Surname</h5>
                    <p><strong>Email:</strong> @item.Email</p>
                    <p>@Html.Raw(item.Message)</p>
                    <small class="text-muted">
                        @item.Date.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center text-muted">Henüz mesaj yok.</p>
    }
</section>
