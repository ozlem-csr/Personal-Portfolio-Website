@model List<KisiselSayfam.Models.Project>

@{
    ViewBag.Title = "Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<section id="projects" class="portfolio section light-background">

    
    <div class="container section-title" data-aos="fade-up">
        <h2>Projelerim</h2>
        <p>Geliştirdiğim çeşitli yazılım projelerini aşağıdaki kategorilerden inceleyebilirsiniz.</p>
    </div>
    

    <div class="container">

        <div class="isotope-layout" data-default-filter=".filter-frontend" data-layout="masonry" data-sort="original-order">

            
            <ul class="portfolio-filters isotope-filters" data-aos="fade-up" data-aos-delay="100">
                <li data-filter=".filter-frontend" class="filter-active">HTML - CSS - JS</li>
                <li data-filter=".filter-sql">SQL</li>
                <li data-filter=".filter-backend">C & C# (Backend)</li>
            </ul>
           

            <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">

               
                <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-frontend">
                    <div class="portfolio-content h-100">
                        <img src="assets/img/projects/frontend-1.jpg" class="img-fluid" alt="">
                        <div class="portfolio-info">
                            <h4>Frontend Proje 1</h4>
                            <p>HTML - CSS - JS ile geliştirilmiş örnek proje.</p>
                            <a href="assets/img/projects/frontend-1.jpg" title="Frontend Proje 1" data-gallery="gallery-frontend" class="glightbox preview-link">
                                <i class="bi bi-zoom-in"></i>
                            </a>
                            <a href="project-details.html" class="details-link" title="Detaylar">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                        </div>
                    </div>
                </div>
               
                <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-sql">
                    <div class="portfolio-content h-100">
                        <img src="assets/img/projects/sql-1.jpg" class="img-fluid" alt="">
                        <div class="portfolio-info">
                            <h4>SQL Proje 1</h4>
                            <p>SQL veri tabanı tasarımı ve sorgular içeren proje.</p>
                            <a href="assets/img/projects/sql-1.jpg" title="SQL Proje 1" data-gallery="gallery-sql" class="glightbox preview-link">
                                <i class="bi bi-zoom-in"></i>
                            </a>
                            <a href="project-details.html" class="details-link" title="Detaylar">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-backend">
                    <div class="portfolio-content h-100">
                        <img src="assets/img/projects/backend-1.jpg" class="img-fluid" alt="">
                        <div class="portfolio-info">
                            <h4>C & C# Proje 1</h4>
                            <p>C# API veya C backend geliştirme örneği.</p>
                            <a href="assets/img/projects/backend-1.jpg" title="Backend Proje 1" data-gallery="gallery-backend" class="glightbox preview-link">
                                <i class="bi bi-zoom-in"></i>
                            </a>
                            <a href="project-details.html" class="details-link" title="Detaylar">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                        </div>
                    </div>
                </div>
               

            </div>
            
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-backend">
                    <div class="portfolio-content h-100">
                        <img src="@item.ImageUrl" class="img-fluid" alt="@item.Title">

                        <div class="portfolio-info">
                            <h4>@item.Title</h4>
                            <p>@item.Description</p>

                            <a href="@item.ImageUrl"
                               data-gallery="gallery-dynamic"
                               class="glightbox preview-link"
                               title="@item.Title">
                                <i class="bi bi-zoom-in"></i>
                            </a>

                            <a href="@item.Url"
                               class="details-link"
                               target="_blank"
                               title="Projeye Git">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>

    </div>

</section>

