@model KisiselSayfam.Models.Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4>Yetenek Güncelle</h4>

<form asp-action="GuncelleAdminSkill" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Yetenek Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Seviye (%)</label>
        <input asp-for="Value" type="number" min="0" max="100" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a asp-action="SkillIndex" class="btn btn-secondary">Vazgeç</a>
</form>
