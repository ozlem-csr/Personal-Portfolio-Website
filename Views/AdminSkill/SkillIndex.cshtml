@model List<KisiselSayfam.Models.Skill>

@{
    ViewData["Title"] = "Yetenek Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<div class="page-header mb-30">
    <div class="row">
        <div class="col-md-6">
            <h4>Yetenek Yönetimi</h4>
        </div>
        <div class="col-md-6 text-right">
            <a asp-controller="AdminSkill"
               asp-action="AddAdminSkill"
               class="btn btn-primary">
                Yeni Ekle
            </a>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="pd-20">
        <table id="skillTable" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Yetenek</th>
                    <th>Seviye (%)</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Value</td>
                        <td>
                            <a asp-controller="AdminSkill"
                               asp-action="GuncelleAdminSkill"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Güncelle
                            </a>

                            <form asp-controller="AdminSkill"
                                  asp-action="SilAdminSkill"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Silmek istiyor musunuz?');">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#skillTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                }
            });
        });
    </script>
}
