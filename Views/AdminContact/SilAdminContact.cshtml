@model KisiselSayfam.Models.Contact

@{
    ViewData["Title"] = "İletişim Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card-box">
    <div class="pd-20">
        <h4 class="text-danger">Silme Onayı</h4>

        <p>Bu iletişim kaydı silinecek. Devam etmek istiyor musunuz?</p>

        <dl class="row">
            <dt class="col-sm-3">Ad</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Soyad</dt>
            <dd class="col-sm-9">@Model.Surname</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Mesaj</dt>
            <dd class="col-sm-9">@Model.Message</dd>

            <dt class="col-sm-3">Tarih</dt>
            <dd class="col-sm-9">@Model.Date.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        <form asp-controller="AdminContact"
              asp-action="SilAdminContact"
              method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Sil
            </button>

            <a asp-action="AdminContact"
               class="btn btn-secondary ml-2">
                Vazgeç
            </a>
        </form>
    </div>
</div>
