@model List<KisiselSayfam.Models.Contact>

@{
    ViewData["Title"] = "İletişim Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header mb-30">
    <div class="row">
        <div class="col-md-6">
            <h4>İletişim Yönetimi</h4>
        </div>
        <div class="col-md-6 text-right">
            <a asp-controller="AdminContact"
               asp-action="AddAdminContact"
               class="btn btn-primary">
                Yeni Ekle
            </a>
        </div>
    </div>
</div>

<div class="card-box mb-30">
    <div class="pb-20">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Mesaj</th>
                    <th>Tarih</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name @item.Surname</td>
                        <td>@item.Email</td>
                        <td>@item.Message</td>
                        <td>@item.Date.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-center">
                            <a asp-action="GuncelleAdminContact"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Güncelle
                            </a>

                            <form asp-action="SilAdminContact"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


