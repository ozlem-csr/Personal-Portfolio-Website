@model KisiselSayfam.Models.Service

@{
    ViewData["Title"] = "Hizmet Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4>Hizmet Güncelle</h4>

<form asp-action="GuncelleAdminService" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label>Icon</label>
        <input asp-for="Icon" class="form-control" />
    </div>

    <div class="form-group">
        <label>Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a asp-action="ServiceIndex" class="btn btn-secondary">Vazgeç</a>
</form>
