@model List<KisiselSayfam.Models.Service>

@{
    ViewData["Title"] = "Hizmet Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header mb-30">
    <div class="row">
        <div class="col-md-6">
            <h4>Hizmet Yönetimi</h4>
        </div>
        <div class="col-md-6 text-right">
            <a asp-controller="AdminService"
               asp-action="AddAdminService"
               class="btn btn-primary">
                Yeni Ekle
            </a>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="pd-20">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Icon</th>
                    <th>Açıklama</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Icon</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-controller="AdminService"
                               asp-action="GuncelleAdminService"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Güncelle
                            </a>

                            <form asp-controller="AdminService"
                                  asp-action="SilAdminService"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Silmek istiyor musunuz?');">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
