@model List<KisiselSayfam.Models.Testimonial>

@{
    ViewData["Title"] = "Referans Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header mb-30">
    <div class="row">
        <div class="col-md-6">
            <h4>Referans Yönetimi</h4>
        </div>
        <div class="col-md-6 text-right">
            <a asp-controller="AdminTestimonial"
               asp-action="AddAdminTestimonial"
               class="btn btn-primary">
                Yeni Ekle
            </a>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="pd-20">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Ünvan</th>
                    <th>Yorum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Title</td>
                        <td>
                            @(item.Comment.Length > 80
                                                    ? item.Comment.Substring(0, 80) + "..."
                                                    : item.Comment)
                    </td>
                    <td>
                        <a asp-controller="AdminTestimonial"
                           asp-action="GuncelleAdminTestimonial"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Güncelle
                        </a>

                            <form asp-controller="AdminTestimonial"
                                  asp-action="SilAdminTestimonial"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Silmek istediğinize emin misiniz?');">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>
                                }
            </tbody>
        </table>
    </div>
</div>
