@model KisiselSayfam.Models.Testimonial

@{
    ViewData["Title"] = "Referans Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4>Referans Güncelle</h4>

<form asp-action="GuncelleAdminTestimonial" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Ad Soyad</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Ünvan</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label>Yorum</label>
        <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
    </div>

    <div class="form-group">
        <label>Görsel URL</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a asp-action="TestimonialIndex" class="btn btn-secondary">Vazgeç</a>
</form>
