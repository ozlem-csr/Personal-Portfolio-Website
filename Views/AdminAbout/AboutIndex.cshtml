@model List<KisiselSayfam.Models.About>

@{
    ViewData["Title"] = "Hakkımda Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header mb-30">
    <div class="row">
        <div class="col-md-6 col-sm-12">
            <div class="title">
                <h4>Hakkımda Yönetimi</h4>
            </div>
        </div>
        <div class="col-md-6 col-sm-12 text-right">
            <a asp-controller="AdminAbout"
               asp-action="AddAdminAbout"
               class="btn btn-primary">
                <i class="dw dw-add"></i> Yeni Ekle
            </a>
        </div>
    </div>
</div>

<div class="card-box mb-30">
    <div class="pd-20">
        <h5 class="text-blue h5">Hakkımda Listesi</h5>
        <p class="mb-0 text-muted">
            Sistemde kayıtlı olan hakkımda bilgileri aşağıda listelenmektedir.
        </p>
    </div>

    <div class="pb-20">
        <table id="aboutTable"
               class="table table-striped table-bordered nowrap"
               style="width:100%">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Açıklama</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>
                                @{
                                    var description = item.Description ?? "";
                                    if (description.Length > 120)
                                    {
                                        @description.Substring(0, 120)
                                        <text>...</text>
                                    }
                                    else
                                    {
                                        @description
                                    }
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="AdminAbout"
                                   asp-action="GuncelleAdminAbout"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-warning mr-1"
                                   title="Düzenle">
                                    <i class="dw dw-edit2"></i>
                                </a>

                                <form asp-controller="AdminAbout"
                                      asp-action="SilAdminAbout"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Sil">
                                        <i class="dw dw-delete-3"></i>
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#aboutTable').DataTable({
                responsive: true,
                autoWidth: false,
                pageLength: 10,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.10.21/i18n/Turkish.json"
                },
                columnDefs: [
                    { orderable: false, targets: 2 }
                ]
            });
        });
    </script>
}
